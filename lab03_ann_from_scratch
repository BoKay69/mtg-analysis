    "    def forward(self, x, apply_sigmoid=False):\n",
    "        output = self.lay1(x) \n",
    "        if apply_sigmoid:\n",
    "            output = self.act(output)\n",
    "        return output\n",
    "\n",
    "model = Perceptron(1)\n",
    "\n",
    "# Define loss function to be used \n",
    "#loss_fn = torch.nn.MSELoss()\n",
    "loss_fn = torch.nn.BCELoss()\n",
